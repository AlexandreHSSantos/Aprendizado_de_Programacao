programa
{
	
	funcao inicio()
	{
inteiro somatorio , soma_atual
cadeia ligadesliga


escreva("O número atualmente é 0.0, qual o valor inicial?")
leia(somatorio)
ligadesliga = ("a")
soma_atual = 0
enquanto (ligadesliga != "n"){
	soma_atual = soma_atual + somatorio
	escreva("O valor de n agora é", soma_atual)

	
	escreva("Quanto você deseja somar?")
	leia(somatorio)
	
	escreva("Deseja somar mais?")
	leia(ligadesliga)
}
}






		

}
